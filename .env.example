# ============================================================
# .env.example — 环境变量模板
# 用法：cp .env.example .env，然后把所有 CHANGE_ME 换成真实值
# ⚠️ .env 已被 .gitignore 忽略，绝不要提交到仓库
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=pptrag
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=pptrag
# SQLAlchemy 异步引擎用 asyncpg 驱动
DATABASE_URL=postgresql+asyncpg://pptrag:CHANGE_ME_strong_password@postgres:5432/pptrag
# LangGraph AsyncPostgresSaver 用 libpq 驱动（psycopg3），不能带 +asyncpg
CHECKPOINT_DATABASE_URL=postgresql://pptrag:CHANGE_ME_strong_password@postgres:5432/pptrag

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/3

# ---- Qdrant ----
QDRANT_URL=http://qdrant:6333
QDRANT_GRPC_PORT=6334

# ---- 安全 ----
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_run_secrets_token_urlsafe_48

# ---- 服务地址（容器间用服务名互访）----
MODELS_ROOT=/models
MODEL_SERVICE_URL=http://model-service:8002
MINERU_URL=http://mineru:8001

# ---- MinerU 设备联动开关 ----
# ★ 唯一入口。cpu（默认）/ cuda
# ⚠️ 改成 cuda 之前必须先读 DESIGN.md 的 D5 决策与第 14.2 节，且启动时要叠加：
#      docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d mineru
#    改这一项会同时改变：显存账 / 锁层级（lock_backend=auto 自动跟随）/ 镜像体积 /
#    以及「上传后 1-3 分钟内问答是否被阻塞」。
MINERU_DEVICE=cpu

# ---- 时区与日志 ----
TZ=Asia/Shanghai
LOG_LEVEL=INFO
