# ============================================================
# ============================================================
# deploy/model-service/Dockerfile.codefix — 只刷新应用代码层（原始说明，留档）
# ------------------------------------------------------------
# 为什么需要这个文件：
#   S3 的流式 /vlm/generate 改在 backend/model_service/ 下，但当时的验证
#   是 docker cp 热拷进容器做的，**镜像从未重建** —— 容器一 recreate 就
#   退回 S2 的 503 占位实现（"VLM 生成端点尚未实现"）。
#
#   正常解法是重建 deploy/model-service/Dockerfile，但它会重跑
#   `pip install -r requirements.txt`（torch + CUDA，数 GB）。2026-09-18
#   那次 buildx prune --all 已把构建缓存清空，完整重建要重新下载全部依赖。
#
#   本文件用一个「代码层补丁」绕开下载：以现有镜像为底座，只 COPY 应用代码，
#   产出几 MB 的一层。跑完 S4 验收后，建议在网络宽裕时做一次完整重建，
#   再用 `docker compose up -d --force-recreate model-service` 收敛回标准镜像。
#
# 用法（在项目根执行）：
#   docker build -f deploy/model-service/Dockerfile.codefix -t pptrag-model-service .
# ============================================================
FROM pptrag-model-service

# 与标准 Dockerfile 的 COPY 范围保持一致，避免两个镜像的文件布局漂移
COPY backend/app/core/ /app/app/core/
COPY backend/app/__init__.py /app/app/__init__.py
COPY backend/model_service/ /app/model_service/
